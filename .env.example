# Skopiuj do .env i uzupełnij. Plik .env nigdy nie trafia do repozytorium.

# Baza danych (lokalnie: docker compose)
DATABASE_URL="postgresql://kompas:kompas@localhost:5432/kompas"

# Opcjonalnie: osobna, pusta baza do testów integracyjnych (tests/db). Bez niej te testy są pomijane.
# TEST_DATABASE_URL="postgresql://kompas:kompas@localhost:5432/kompas_test"

# Uwierzytelnianie (Auth.js) – wygeneruj: npx auth secret
AUTH_SECRET=""

# Wdrożenie produkcyjne: SEED_ON_DEPLOY="false" wyłącza odtwarzanie danych demo przy każdym wdrożeniu (docs/WDROZENIE.md)
# SEED_ON_DEPLOY="true"

# Tryb demo: karty kont demo na ekranie logowania i reset danych
DEMO_MODE="true"

# Model językowy – dowolny dostawca zgodny z API OpenAI. Puste = aplikacja działa w trybie bez AI.
# Przykłady:
#   lokalnie (Ollama):  LLM_BASE_URL="http://localhost:11434/v1"   LLM_MODEL="<nazwa modelu z `ollama list`>"   (klucz zbędny)
#   Groq (darmowy plan): LLM_BASE_URL="https://api.groq.com/openai/v1"   LLM_MODEL="<model z konsoli Groq>"   LLM_API_KEY="<klucz>"
#   Gemini (darmowy plan): LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"   LLM_MODEL="<model>"   LLM_API_KEY="<klucz>"
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""
LLM_EMBED_MODEL=""
# Limit czasu odpowiedzi modelu w ms (domyślnie 30000)
LLM_TIMEOUT_MS=""
